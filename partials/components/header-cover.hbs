<section class="gh-header is-classic has-image gh-border gh-outer">

    <img class="gh-header-image" src="{{@site.cover_image}}" alt="{{@site.title}}" fetchpriority="high">

    <div class="gh-header-inner gh-inner">

        <div class="is-title">
            <h1 class="gh-header-title">
                {{#if @custom.header_text}}{{@custom.header_text}}{{else}}{{@site.title}}{{/if}}
            </h1>
            <p class="gh-header-subtitle">
                {{#if @custom.signup_subheading}}{{@custom.signup_subheading}}{{else}}{{@site.description}}{{/if}}
            </p>
        </div>

    </div>

</section>
