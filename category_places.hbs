{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

{{#page}}

    {{#match @page.show_title_and_feature_image}}
        <header class="gh-article-header gh-canvas">
            <h1 class="gh-article-title is-title">{{title}}</h1>
            {{#if custom_excerpt}}
                <p class="gh-article-excerpt is-body">{{custom_excerpt}}</p>
            {{/if}}
            {{> "feature-image"}}
        </header>
    {{/match}}

    <div class="gh-content is-body">

        <section class="gh-canvas">
            {{content}}
        </section>

        <section class="gh-container is-{{#match postFeedStyle "List"}}list{{else}}grid{{/match}}{{#if showSidebar}} has-sidebar{{/if}}{{#unless @custom.show_images_in_feed}} no-image{{/unless}} gh-outer">
            <div class="gh-container-inner gh-inner">
                <main class="gh-main">
                    <div class="gh-feed">
                        {{#get "tags" limit="all" include="count.posts" order="name asc" filter="slug:~^'place-'"}}
                            {{#foreach tags}}
                                {{> "tag-card" title=name}}
                            {{/foreach}}
                        {{/get}}

                    </div>

                    {{#match pagination.pages ">" 1}}
                        <div class="gh-more is-title">
                            <a href="{{@site.url}}/page/2/">{{t "See all"}} {{> "icons/arrow"}}</a>
                        </div>
                    {{/match}}
                </main>

            </div>
        </section>
    </div>

{{/page}}
