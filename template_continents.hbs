{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

{{#page}}

    {{#match @page.show_title_and_feature_image}}
        <header class="gh-article-header gh-canvas">
            <h1 class="gh-article-title is-title">{{title}}</h1>
            {{#if custom_excerpt}}
                <p class="gh-article-excerpt is-body">{{custom_excerpt}}</p>
            {{/if}}
            {{> "feature-image"}}
        </header>
    {{/match}}

    <main class="gh-main">
        <section class="gh-canvas gh-content is-body">
            {{content}}
        </section>

        <section class="gh-container is-{{#match @custom.post_feed_style "List"}}list{{else}}grid{{/match}}{{#unless @custom.show_images_in_feed}} no-image{{/unless}} gh-outer">
            <div class="gh-container-inner gh-inner">
                <div class="gh-main">
                    <div class="gh-feed">
                        {{#get "tags" limit="all" include="count.posts" order="name asc" filter="slug:~^'continent-'"}}
                            {{#foreach tags}}
                                {{> "tag-card" title=name}}
                            {{/foreach}}
                        {{/get}}
                    </div>
                </div>
            </div>
        </section>

        <section class="gh-content">
          <br />
        </section>
    </main>

{{/page}}
